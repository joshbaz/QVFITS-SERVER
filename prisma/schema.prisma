generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  active
  invited
  suspended
}

/// Owner, Manager and Staff are seeded with `system: true`; the team can add their own.
/// The id is a readable slug ("owner", "photographer") because the client keys roles by it.
model Role {
  id          String   @id @map("_id")
  name        String
  description String   @default("")
  system      Boolean  @default(false)
  /// { [module]: ["view", "edit", ...] }, modules from src/data/permissions.json
  permissions Json
  staff       Staff[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Everyone who can sign in to the admin.
model Staff {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String         @unique
  /// Null until an invited person sets their password.
  passwordHash    String?
  roleId          String
  role            Role           @relation(fields: [roleId], references: [id])
  /// Per-person permission changes laid over the role's.
  overrides       Json
  status          StaffStatus
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  lastSeenAt      DateTime?
  refreshTokens   RefreshToken[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([inviteTokenHash])
}

/// One per signed-in browser tab session. Only the hash is stored; each refresh rotates it.
model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  staffId   String    @db.ObjectId
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
}

/// One-time switches. The unique _id makes "create the first owner" succeed exactly once.
model SystemLock {
  id        String   @id @map("_id")
  createdAt DateTime @default(now())
}

/* Catalog. Ids are readable slugs ("leggings", "teal") because the client's links, menus and filters store them. */

type Photo {
  /// ImageKit's fileId for an upload; a /photos id or a CDN id for older photos.
  id      String
  url     String?
  width   Int
  height  Int
  widths  Int[]
  colorId String?
}

/// One sellable unit: a colour in a size, with its own SKU and stock.
type Variant {
  id      String
  sku     String
  colorId String
  size    String
  stock   Int
}

type Seo {
  title       String @default("")
  description String @default("")
}

/// A storefront "Shop by" group: Category (the one system group), tags or edits.
model ShopGroup {
  id            String   @id @map("_id")
  name          String
  slug          String
  previousSlugs String[]
  kind          String
  position      Int
  inMenu        Boolean
  inFilters     Boolean
  active        Boolean
}

model Category {
  id            String   @id @map("_id")
  name          String
  slug          String
  parentId      String?
  /// A /photos id, an uploaded Photo, or null.
  image         Json?
  description   String   @default("")
  position      Int
  active        Boolean
  inHeader      Boolean  @default(false)
  previousSlugs String[]
}

/// An item in a tags or edits group (Running, High support, New in).
model Term {
  id            String   @id @map("_id")
  groupId       String
  name          String
  slug          String
  previousSlugs String[]
  image         Json?
  description   String   @default("")
  /// Edits only: what the item opens.
  target        Json?
  position      Int
  active        Boolean
  inHeader      Boolean  @default(false)

  @@index([groupId])
}

model Color {
  id       String @id @map("_id")
  name     String
  hex      String
  position Int
}

model Size {
  id       String @id @map("_id")
  label    String
  group    String
  position Int
}

model Product {
  id               String    @id @map("_id")
  slug             String    @unique
  /// Set once the piece has been live, so its address never changes after that.
  slugLocked       Boolean   @default(false)
  name             String
  status           String
  categoryId       String    @default("")
  price            Int
  compareAtPrice   Int?
  salePercent      Int?
  type             String
  kitItems         String[]
  isNew            Boolean
  pinnedBestseller Boolean
  colorIds         String[]
  termIds          String[]
  blurb            String    @default("")
  details          String[]
  fit              String?
  fitNote          String?
  fabric           String?
  care             String?
  variants         Variant[]
  photos           Photo[]
  seo              Seo
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Every change to one size of one colour, with who made it and why.
model StockMovement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  at          DateTime @default(now())
  productId   String
  productName String
  color       String
  size        String
  from        Int
  to          Int
  reason      String
  /// The order or return it came from: QV-XXXXXX.
  ref         String?
  by          String

  @@index([at])
  @@index([productId])
}

model Review {
  id        String   @id @map("_id")
  productId String?
  name      String
  text      String
  stars     Int
  status    String
  badge     String?
  createdAt DateTime @default(now())
}

/// Single documents: the filter layout ("filters") and the size chart ("size-chart").
model CatalogDocument {
  id        String   @id @map("_id")
  data      Json
  updatedAt DateTime @updatedAt
}

/* Shop settings, delivery and payment. */

/// Single shop documents: the settings ("settings").
model ShopDocument {
  id        String   @id @map("_id")
  data      Json
  updatedAt DateTime @updatedAt
}

model ShippingZone {
  id          String  @id @map("_id")
  name        String
  description String  @default("")
  fee         Int
  /// Free delivery from this subtotal; null uses the shop-wide threshold.
  freeOver    Int?
  /// Collected from the showroom, so no address is needed.
  collect     Boolean @default(false)
  etaDays     String  @default("")
  active      Boolean @default(true)
  position    Int
}

model PaymentMethod {
  id           String  @id @map("_id")
  label        String
  short        String  @default("")
  instructions String  @default("")
  active       Boolean @default(true)
  position     Int
}

type DiscountScope {
  scope String
  ids   String[]
}

model Discount {
  id               String        @id @map("_id")
  /// Stored in capitals; matching ignores case.
  code             String        @unique
  description      String        @default("")
  type             String
  value            Int
  minSpend         Int           @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  appliesTo        DiscountScope
  onSaleItems      Boolean       @default(false)
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
}

/* Customers. */

type Address {
  id      String
  label   String
  region  String
  address String
  phone   String
}

type CartLine {
  productId String
  size      String
  color     String
  qty       Int
  kitId     String?
}

model Customer {
  id               String    @id @map("_id")
  name             String
  email            String    @unique
  phone            String?
  /// The last nine digits, so +256 772 410 218 and 0772410218 match. One account per phone.
  phoneDigits      String?
  passwordHash     String
  addresses        Address[]
  wishlist         String[]
  bag              CartLine[]
  recentlyViewed   String[]
  notes            String    @default("")
  tags             String[]
  emailConfirmedAt DateTime?
  confirmTokenHash String?
  resetTokenHash   String?
  resetExpiresAt   DateTime?
  createdAt        DateTime  @default(now())

  @@index([phoneDigits])
  @@index([confirmTokenHash])
  @@index([resetTokenHash])
}

/// A shopper's refresh token. `persistent` is "stay signed in": the cookie outlives the browser.
model CustomerSession {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash  String    @unique
  customerId String
  persistent Boolean
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/* Orders, money and returns. */

type OrderLine {
  productId String
  name      String
  size      String
  color     String
  colorId   String?
  qty       Int
  price     Int
  kitId     String?
}

type OrderEvent {
  status String
  at     DateTime
  by     String
  note   String?
}

type OrderNote {
  id   String
  text String
  by   String
  at   DateTime
}

model Order {
  id            String       @id @map("_id")
  /// What the customer quotes: QV-XXXXXX.
  ref           String       @unique
  customerId    String?
  name          String
  phone         String
  phoneDigits   String
  email         String?
  region        String
  address       String?
  note          String?
  lines         OrderLine[]
  subtotal      Int
  delivery      Int
  discount      Int
  discountCode  String?
  kitSaving     Int          @default(0)
  total         Int
  payment       String
  paymentStatus String
  status        String
  history       OrderEvent[]
  notes         OrderNote[]
  /// web, showroom, whatsapp (manual is older records)
  source        String       @default("web")
  /// Set once its stock is back on the shelf (cancelled or expired), so it never goes back twice.
  stockReturned Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([customerId])
  @@index([phoneDigits])
  @@index([status, paymentStatus])
  @@index([discountCode])
  @@index([createdAt])
}

model Transaction {
  id        String   @id @map("_id")
  orderId   String
  orderRef  String
  /// payment or refund
  type      String
  method    String
  amount    Int
  /// pending, succeeded or failed
  status    String
  reference String   @default("")
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

type ReturnLine {
  productId String
  name      String
  size      String
  color     String
  qty       Int
  price     Int
}

model ReturnRequest {
  id         String       @id @map("_id")
  orderId    String
  orderRef   String
  customerId String?
  name       String
  lines      ReturnLine[]
  reason     String
  /// refund or exchange
  resolution String
  status     String
  note       String?
  /// Set once the pieces are back on the shelf, so a return restocks once.
  restocked  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([orderId])
  @@index([customerId])
}

/// Every email the shop sends, and what happened to it. Sent through Zoho Mail by the email queue.
model OutboxEmail {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  to        String
  kind      String
  subject   String
  body      String
  link      String?
  ref       String?
  /// queued (waiting to send), sent, failed (gave up), held (no email service set up), no_email (only a phone)
  status    String    @default("queued")
  /// A newsletter email's own unsubscribe link.
  unsubscribe String?
  /// A campaign's product cards and button, for the email layout.
  meta      Json?
  attempts  Int       @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ref])
  @@index([createdAt])
  @@index([status])
}

/* Newsletter, messages, Vee and the activity log. */

/// One address on the newsletter, with the consent that put it there (double opt-in).
model Subscriber {
  id               String    @id @map("_id")
  email            String    @unique
  name             String?
  customerId       String?
  /// pending (until the emailed link is opened), subscribed, unsubscribed
  status           String
  source           String
  /// The words they agreed to, as shown when they signed up.
  consentText      String
  consentedAt      DateTime
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  confirmTokenHash String?
  /// The welcome code goes once per address, ever.
  welcomeSentAt    DateTime?
  createdAt        DateTime  @default(now())

  @@index([confirmTokenHash])
  @@index([status])
}

/// A newsletter email: drafted, scheduled or sent (then locked) to confirmed subscribers.
model Campaign {
  id          String    @id @map("_id")
  subject     String
  previewText String    @default("")
  heading     String    @default("")
  body        String    @default("")
  productIds  String[]
  /// { label, target, href }: the button, its href worked out when saved.
  cta         Json
  /// draft, scheduled, sending, sent
  status      String
  sendAt      DateTime?
  sentAt      DateTime?
  recipients  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, sendAt])
}

/// The contact form's messages, for the admin's inbox.
model ContactMessage {
  id        String   @id @map("_id")
  name      String
  phone     String?
  email     String?
  topic     String?
  message   String
  /// new, read, replied, archived
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// What shoppers asked Vee: only the words and whether she answered. The newest 200 are kept.
model VeeQuestion {
  id        String   @id @map("_id")
  text      String
  answered  Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Who changed what in the admin, and when. The newest 2000 are kept.
model ActivityEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String?
  actorName String
  module    String
  action    String
  entityId  String?
  summary   String
  at        DateTime @default(now())

  @@index([at])
}
