# Copy to .env and fill in. The server checks these at start-up (src/env.mjs).
NODE_ENV="development"
PORT=5000

# Prisma needs MongoDB running as a replica set (Atlas and DigitalOcean Managed MongoDB already are).
# Local: the qvfits-mongo Docker container on 27018.
DATABASE_URL="mongodb://localhost:27018/qvfits?replicaSet=rs0"

# At least 32 characters. Generate one with: openssl rand -hex 32
AUTH_SECRET=""

# Local: the qvfits-redis Docker container on 6380.
REDIS_URL="redis://localhost:6380"

# Where the client runs; invite links point here.
APP_URL="http://localhost:5173"
