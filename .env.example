# Copy to .env and fill in. The server checks these at start-up (src/env.mjs).
NODE_ENV="development"
PORT=5000

# Prisma needs MongoDB running as a replica set (Atlas and DigitalOcean Managed MongoDB already are).
# Local: the qvfits-mongo Docker container on 27018.
DATABASE_URL="mongodb://localhost:27018/qvfits?replicaSet=rs0"

# At least 32 characters. Generate one with: openssl rand -hex 32
AUTH_SECRET=""

# Local: the qvfits-redis Docker container on 6380.
REDIS_URL="redis://localhost:6380"

# Where the client runs; invite links point here.
APP_URL="http://localhost:5173"

# Photo uploads. ImageKit dashboard, Developer options.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# Email through Zoho Mail. Without a user and password, emails stay in the admin Outbox unsent.
# smtp.zoho.com (personal) or smtppro.zoho.com (your own domain); use the .eu/.in host if your account is there.
ZOHO_SMTP_HOST="smtppro.zoho.com"
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER="orders@qvfits.com"
# An app-specific password: Zoho Accounts, Security, App passwords.
ZOHO_SMTP_PASSWORD=""
MAIL_FROM="QVFITS <orders@qvfits.com>"
MAIL_REPLY_TO=""
