# Copy to .env and fill in. The server checks these at start-up (src/env.mjs).
NODE_ENV="development"
PORT=5000

# Prisma needs MongoDB running as a replica set (Atlas and DigitalOcean Managed MongoDB already are).
# Local: the qvfits-mongo Docker container on 27018.
DATABASE_URL="mongodb://localhost:27018/qvfits?replicaSet=rs0"

# At least 32 characters. Generate one with: openssl rand -hex 32
AUTH_SECRET=""

# Local: the qvfits-redis Docker container on 6380.
REDIS_URL="redis://localhost:6380"

# Where the client runs; invite links point here.
APP_URL="http://localhost:5173"

# Photo uploads. ImageKit dashboard, Developer options.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# Email: ZeptoMail, else Zoho Mail SMTP. With neither set, emails stay in the admin Outbox unsent.
# ZeptoMail: the Mail Agent's Send Mail token (SMTP/API, API tab). Used first when set. The
# domain in MAIL_FROM must be verified in ZeptoMail (SPF and DKIM). Test with: yarn mail:test you@example.com
ZEPTOMAIL_TOKEN=""
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"
# Or Zoho Mail SMTP (blocked on DigitalOcean Droplets).
# smtp.zoho.com (personal) or smtppro.zoho.com (your own domain); use the .eu/.in host if your account is there.
ZOHO_SMTP_HOST="smtppro.zoho.com"
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER="sales@qvfits.com"
# An app-specific password: Zoho Accounts, Security, App passwords.
ZOHO_SMTP_PASSWORD=""
MAIL_FROM="QVFITS <sales@qvfits.com>"
MAIL_REPLY_TO=""
# A hidden copy of every sales email (order updates, low stock) and newsletter email (confirm,
# welcome, one per campaign); "off" stops one. Newsletter and contact form emails come from
# MAIL_INFO_FROM. These are the defaults:
MAIL_SALES_COPY="sales@qvfits.com"
MAIL_NEWSLETTER_COPY="info@qvfits.com"
MAIL_INFO_FROM="QVFITS <info@qvfits.com>"

# Online payments through Pesapal (mobile money and cards). developer.pesapal.com, then your
# merchant dashboard for the live keys. Without them, MTN, Airtel and card orders keep the
# WhatsApp hand-off, as before. Test with sandbox keys before switching PESAPAL_ENV to live.
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
# The API's public address; Pesapal's payment notifications (IPN) go to
# <API_URL>/api/v1/payments/pesapal/ipn. Must be reachable from the internet (https).
API_URL=""
# Only if the IPN address differs from the one above.
PESAPAL_IPN_URL=""
